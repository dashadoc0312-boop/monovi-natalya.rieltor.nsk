# Скопируйте этот файл в .env.local (локально) или добавьте переменные в настройках Vercel.

# Токен Telegram-бота, который будет присылать заявки. Получить у @BotFather.
TELEGRAM_BOT_TOKEN=

# ID чата, куда бот отправляет заявки (личный чат или группа). Как узнать — см. README.
TELEGRAM_CHAT_ID=

# Адрес сайта после публикации (для превью ссылок и SEO), без слеша в конце.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
